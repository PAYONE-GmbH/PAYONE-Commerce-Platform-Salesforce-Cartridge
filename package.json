{
  "name": "pcp-salesforce-cartridge",
  "version": "26.1.0",
  "description": "PAYONE Commerce Platform Cartridge for Salesforce Commerce Cloud",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "mocha test/unit/**/*.js",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:isml",
    "lint:js": "eslint \"cartridges/*/cartridge/**/*.js\"",
    "lint:css": "stylelint --allow-empty-input \"cartridges/**/*.scss\"",
    "lint:isml": "isml-linter --build",
    "compile:js": "webpack --env production --env compile=js",
    "compile:scss": "webpack --env production --env compile=scss",
    "watch": "webpack --env development --watch",
    "build": "webpack --env development"
  },
  "author": "PAYONE GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PAYONE-GmbH/PAYONE-Commerce-Platform-Salesforce-Cartridge.git"
  },
  "homepage": "https://github.com/PAYONE-GmbH/PAYONE-Commerce-Platform-Salesforce-Cartridge#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "chai": "^4.5.0",
    "chalk": "^4.1.2",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "5.2.4",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "fs-extra": "^9.1.0",
    "glob": "^9.3.5",
    "isml-linter": "^5.43.9",
    "mini-css-extract-plugin": "^2.9.0",
    "minimatch": "^8.0.4",
    "mocha": "^10.8.2",
    "postcss": "^8.4.39",
    "postcss-loader": "^7.3.4",
    "proxyquire": "^2.1.3",
    "sass": "^1.77.6",
    "sass-loader": "^13.3.3",
    "sinon": "^17.0.1",
    "stylelint": "^14.16.1",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-config-standard-scss": "^6.1.0",
    "stylelint-scss": "^5.3.2",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "last 2 versions",
    "ie >= 10"
  ],
  "packageName": "int_payone_commerce",
  "babel": {
    "presets": [
      "env"
    ]
  },
  "cartridges": [
    "bm_payone_commerce",
    "int_payone_commerce"
  ],
  "dependencies": {
    "@google-pay/button-element": "^3.2.1",
    "@paypal/paypal-js": "^9.5.0",
    "pcp-client-javascript-sdk": "^1.4.0"
  }
}