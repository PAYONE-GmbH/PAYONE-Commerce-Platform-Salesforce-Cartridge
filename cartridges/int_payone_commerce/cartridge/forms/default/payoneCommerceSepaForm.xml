<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19">

    <field formid="sepaIban"
           label="label.input.sepaIban"
           type="string"
           mandatory="true"
           binding="sepaIban"
           max-length="34"
           missing-error="payment.sepaIban.number.missing"
           parse-error="error.message.required" />

    <field formid="sepaAccountHolder"
           label="label.input.sepaAccountHolder"
           type="string"
           mandatory="true"
           binding="sepaAccountHolder"
           missing-error="error.message.required" />

<!-- SEPA Country  -->
