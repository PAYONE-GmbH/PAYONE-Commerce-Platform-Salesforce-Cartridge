{
  "step-types": {
    "chunk-script-module-step": [
      {
        "@type-id": "custom.PayoneProcessWebhookEventsChunk",
        "@supports-parallel-execution": "false",
        "@supports-site-context": "true",
        "@supports-organization-context": "false",
        "description": "Process pending PAYONE webhook events in chunks.",
        "module": "int_payone_commerce/cartridge/scripts/jobs/processPayoneWebhookEvents.js",
        "before-step-function": "beforeStep",
        "total-count-function": "getTotalCount",
        "read-function": "read",
        "process-function": "process",
        "write-function": "write",
        "after-step-function": "afterStep",
        "chunk-size": 50,
        "transactional": "false",
        "parameters": {
          "parameter": [
            {
              "@name": "MaxItems",
              "@type": "long",
              "@required": "false",
              "description": "Maximum number of pending events to process in one run.",
              "default-value": "200",
              "min-value": "1"
            }
          ]
        },
        "status-codes": {
          "status": [
            {
              "@code": "OK",
              "description": "Step completed successfully."
            },
            {
              "@code": "ERROR",
              "description": "Step failed."
            }
          ]
        }
      }
    ]
  }
}
