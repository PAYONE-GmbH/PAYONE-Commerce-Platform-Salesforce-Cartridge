<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="OrderPaymentInstrument">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="payonePaymentMethodSpecificInput">
                <display-name xml:lang="x-default">PAYONE Payment Method Specific Input</display-name>
                <description xml:lang="x-default">Serialized PAYONE paymentMethodSpecificInput payload captured during checkout.</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="payoneCustomerDataOverride">
                <display-name xml:lang="x-default">PAYONE Customer Data Override</display-name>
                <description xml:lang="x-default">Serialized checkout-specific customer/contact override data captured for the current PAYONE payment attempt.</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="payonePayPalPaymentContext">
                <display-name xml:lang="x-default">PAYONE PayPal Payment Context</display-name>
                <description xml:lang="x-default">Serialized PAYONE PayPal JS SDK context captured before SFCC order creation.</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="payoneSecureInstallmentContext">
                <display-name xml:lang="x-default">PAYONE Secure Installment Context</display-name>
                <description xml:lang="x-default">Serialized PAYONE Secure Installment context captured before SFCC order creation.</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="payonePaymentInstrument">
                <display-name xml:lang="x-default">PAYONE Payment Instrument</display-name>
                <attribute attribute-id="payonePaymentMethodSpecificInput"/>
                <attribute attribute-id="payoneCustomerDataOverride"/>
                <attribute attribute-id="payonePayPalPaymentContext"/>
                <attribute attribute-id="payoneSecureInstallmentContext"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>
