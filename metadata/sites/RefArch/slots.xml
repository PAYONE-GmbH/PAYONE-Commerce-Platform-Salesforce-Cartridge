<?xml version="1.0" encoding="UTF-8"?>
<slot-configurations xmlns="http://www.demandware.com/xml/impex/slot/2008-09-08">

    <slot-configuration slot-id="payone-storepay" context="global" configuration-id="PayStoreMesage" default="true" assigned-to-site="true">
        <template>slots/html/htmlSlotContainer.isml</template>
        <enabled-flag>true</enabled-flag>
        <content>
            <html>
                <body xml:lang="x-default">Payment will be done offline in the store</body>
            </html>
        </content>
    </slot-configuration>

    <slot-configuration slot-id="payone-wero" context="global" configuration-id="Payone Wero Message" default="true" assigned-to-site="true">
        <template>slots/html/htmlSlotContainer.isml</template>
        <enabled-flag>true</enabled-flag>
        <content>
            <html>
                <body xml:lang="x-default">You will be redirected to Wero to complete your payment.</body>
                <body xml:lang="de-DE">Sie werden zu Wero weitergeleitet, um Ihre Zahlung abzuschließen.</body>
            </html>
        </content>
    </slot-configuration>

    <slot-configuration slot-id="payone-secure-terms" context="global" configuration-id="Payone Terms" default="true" assigned-to-site="true">
        <template>slots/content/contentAssetBody.isml</template>
        <enabled-flag>true</enabled-flag>
        <content>
            <content-assets>
                <content-asset content-id="payoneTerms"/>
            </content-assets>
        </content>
    </slot-configuration>

</slot-configurations>
