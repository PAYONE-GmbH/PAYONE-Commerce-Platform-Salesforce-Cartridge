<?xml version="1.0" encoding="UTF-8"?>
<payment-settings xmlns="http://www.demandware.com/xml/impex/paymentsettings/2009-09-15">

    <payment-method method-id="PAYONE_COMMERCE_CARD">
        <name xml:lang="x-default">Payone Commerce Card</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
    </payment-method>

    <payment-method method-id="PAYONE_COMMERCE_SEPA">
        <name xml:lang="x-default">Payone Commerce SEPA Direct Debit</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
        <currencies>
            <currency>EUR</currency>
        </currencies>
    </payment-method>

    <payment-method method-id="PAYONE_COMMERCE_SECURE_INVOICE">
        <name xml:lang="x-default">Payone Commerce Secured Invoice</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
        <countries>
            <country country-code="AT"/>
            <country country-code="DE"/>
        </countries>
        <currencies>
            <currency>EUR</currency>
        </currencies>
        <ranges>
            <range currency="EUR">
                <min-purchase-amount>10</min-purchase-amount>
                <max-purchase-amount>1500</max-purchase-amount>
            </range>
        </ranges>
    </payment-method>

    <payment-method method-id="PAYONE_COMMERCE_SECURE_INSTALLMENT">
        <name xml:lang="x-default">Payone Commerce Secured Installment</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
        <countries>
            <country country-code="AT"/>
            <country country-code="DE"/>
        </countries>
        <currencies>
            <currency>EUR</currency>
        </currencies>
        <ranges>
            <range currency="EUR">
                <min-purchase-amount>200</min-purchase-amount>
                <max-purchase-amount>3500</max-purchase-amount>
            </range>
        </ranges>
    </payment-method>

    <payment-method method-id="PAYONE_COMMERCE_SECURE_DIRECT_DEBIT">
        <name xml:lang="x-default">Payone Commerce Secured Direct Debit</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
        <countries>
            <country country-code="AT"/>
            <country country-code="DE"/>
        </countries>
        <currencies>
            <currency>EUR</currency>
        </currencies>
        <ranges>
            <range currency="EUR">
                <min-purchase-amount>10</min-purchase-amount>
                <max-purchase-amount>1500</max-purchase-amount>
            </range>
        </ranges>
    </payment-method>

    <payment-method method-id="PAYONE_COMMERCE_PAYPAL">
        <name xml:lang="x-default">Payone Commerce PayPal</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
    </payment-method>

    <payment-method method-id="PAYONE_COMMERCE_GOOGLEPAY">
        <name xml:lang="x-default">Payone Commerce Google Pay</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
    </payment-method>

    <payment-method method-id="DW_APPLE_PAY">
        <name xml:lang="x-default">Payone Commerce Apple Pay</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
    </payment-method>

    <payment-method method-id="PAYONE_COMMERCE_STORE_PAY">
        <name xml:lang="x-default">Payone Commerce Pay in store</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYONE_COMMERCE</processor-id>
    </payment-method>

</payment-settings>
